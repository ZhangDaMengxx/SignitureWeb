# 数据库配置
DATABASE_URL=postgres://postgres:password@localhost:5432/design_inspiration

# 或分开配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=design_inspiration

# 服务器配置
PORT=3001
NODE_ENV=development

# 前端地址（CORS）
FRONTEND_URL=http://localhost:5173

# Gemini API Key
GEMINI_API_KEY=your_api_key_here
